#include <iostream>
using namespace std;

int maximum(int a, int b)
{
    return (a > b) ? a : b;
}

int maximum(int a, int b, int c)
{
    return maximum(maximum(a, b), c);
}

int main()
{
    int a, b, c;

    cout << "Enter two integers: ";
    cin >> a >> b;
    cout << "Maximum = " << maximum(a, b) << endl;

    cout << "Enter three integers: ";
    cin >> a >> b >> c;
    cout << "Maximum = " << maximum(a, b, c) << endl;

    return 0;
}
